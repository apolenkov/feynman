{
  "name": "@albinocrabs/feynman",
  "version": "2.0.0",
  "description": "Codex plugin that auto-injects readable ASCII diagram rules via the SessionStart hook",
  "license": "MIT",
  "author": "apolenkov",
  "keywords": [
    "codex",
    "codex-plugin",
    "openai",
    "ascii-diagrams",
    "visual-architecture",
    "developer-tools",
    "hook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apolenkov/feynman.git"
  },
  "homepage": "https://github.com/apolenkov/feynman#readme",
  "bugs": {
    "url": "https://github.com/apolenkov/feynman/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "lib/lint/index.ts",
  "bin": {
    "feynman": "bin/feynman.ts",
    "feynman-lint": "bin/feynman-lint.ts"
  },
  "files": [
    "hooks/",
    "lib/",
    "bin/",
    "rules/",
    ".agents/",
    "plugins/",
    "docs/",
    "examples/",
    "install.sh",
    "uninstall.sh",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "coverage": "mkdir -p coverage && node --experimental-test-coverage --test-coverage-exclude=tests/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test tests/*.test.ts",
    "check:coverage": "node scripts/check-coverage.ts",
    "lint": "node bin/feynman-lint.ts",
    "eslint": "eslint .",
    "audit": "npm audit --audit-level=moderate",
    "test:docs": "node scripts/check-docs.ts",
    "test:release": "node scripts/release-smoke.ts",
    "test:published": "node scripts/verify-published-package.ts",
    "build": "node scripts/build-package.ts",
    "changelog": "node scripts/generate-changelog.ts",
    "ci": "npm run audit && npm run typecheck && npm run eslint && npm run coverage && npm run check:coverage && npm run test:docs && npm run build && npm run test:release",
    "prepublishOnly": "npm run audit && npm run typecheck && npm run coverage && npm run check:coverage && npm run test:docs",
    "release": "npm run ci && npm publish \"$(cat dist/TARBALL.txt)\" --access public"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3"
  }
}
