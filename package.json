{
  "name": "@albinocrabs/feynman",
  "version": "2.1.1",
  "description": "Visual-explanation skill for Codex with an optional session hook and ASCII diagram linter",
  "license": "MIT",
  "author": "apolenkov",
  "keywords": [
    "codex",
    "codex-plugin",
    "openai",
    "ascii-diagrams",
    "visual-architecture",
    "developer-tools",
    "hook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apolenkov/feynman.git"
  },
  "homepage": "https://github.com/apolenkov/feynman#readme",
  "bugs": {
    "url": "https://github.com/apolenkov/feynman/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "lib/lint/index.ts",
  "bin": {
    "feynman": "bin/feynman.ts",
    "feynman-lint": "bin/feynman-lint.ts"
  },
  "files": [
    "hooks/",
    "lib/",
    "bin/",
    "rules/",
    ".agents/",
    "plugins/",
    "docs/",
    "examples/",
    "install.sh",
    "uninstall.sh",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "coverage": "mkdir -p coverage && node --experimental-test-coverage --test-coverage-exclude=tests/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test --test-concurrency=1 tests/*.test.ts",
    "check:coverage": "node scripts/check-coverage.ts",
    "lint": "node bin/feynman-lint.ts",
    "eslint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,mjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,yml,yaml}\"",
    "audit": "npm audit --audit-level=moderate",
    "test:docs": "node scripts/check-docs.ts",
    "test:release": "node scripts/release-smoke.ts",
    "test:published": "node scripts/verify-published-package.ts",
    "build": "node scripts/build-package.ts",
    "changelog": "node scripts/generate-changelog.ts",
    "check:factory-workflows": "node scripts/check-factory-workflows.ts",
    "ci": "npm run audit && npm run format:check && npm run typecheck && npm run eslint && npm run check:factory-workflows && npm run coverage && npm run check:coverage && npm run test:docs && npm run check:reproducibility && npm run test:release",
    "prepublishOnly": "npm run audit && npm run typecheck && npm run coverage && npm run check:coverage && npm run test:docs",
    "release": "npm run ci && npm publish \"./$(cat dist/TARBALL.txt)\" --access public",
    "check:reproducibility": "node scripts/check-reproducibility.ts",
    "prepare": "lefthook install >/dev/null 2>&1 || true"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@actions/workflow-parser": "0.3.61",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "canonicalize": "5.1.0",
    "eslint": "^10.12.0",
    "jiti": "2.7.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "^6.0.3"
  }
}
